# KDE 测试环境（最小：仅 kwin，不装完整 Plasma 会话）
# 无头方案：kwin 嵌套运行在 cage(wlroots headless) 里，录屏走 cage 的 screencopy
FROM aiinput-host:latest

USER root

RUN pacman -Syu --noconfirm --needed \
        kwin \
        && pacman -Scc --noconfirm

# kwin_wayland 自带 cap_sys_nice 文件能力，rootless 容器缺该能力会 exec EPERM；
# 该能力只用于实时调度优先级，测试环境不需要，直接移除
RUN setcap -r /usr/sbin/kwin_wayland

USER testuser
WORKDIR /home/testuser

CMD ["/bin/bash"]
