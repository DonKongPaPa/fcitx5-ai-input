# niri 测试环境（最小）
# 无头方案：sway(wlroots headless, 帧时钟) 托管 niri 嵌套运行
#（niri 官方不支持 headless 输出，见 niri-wm/niri Discussion #714；
#  曾用 cage 托管，但其 headless 输出 1280x720 硬编码不可调——1080p 需
#  sway 的 output resolution 配置，与 kde/gnome 环境同款托管）
FROM aiinput-host:latest

USER root

RUN pacman -Syu --noconfirm --needed \
        niri sway fcitx5-configtool grim \
        chromium fcitx5-chinese-addons python-pillow \
        && pacman -Scc --noconfirm

# niri 最小配置：
# - gaps 200 让窗口内缩，文本框光标落在屏幕中部（模拟真实几何，也避免
#   input popup 放在光标上方时顶部越界被裁——niri 不 clamp 该越界）
# - hotkey-overlay skip-at-startup：默认的 Important Hotkeys 帮助面板会占
#   据屏幕右侧，污染录屏画面与视觉断言
# - 注意：niri 26.04 的 KDL 解析不接受旧版 `animations { workspace-switch { off } }`
#   单行内联写法（解析失败会静默回退默认配置+弹错误提示窗），故移除
RUN mkdir -p /home/testuser/.config/niri && \
    printf '%s\n' \
        'layout {' \
        '    gaps 200' \
        '}' \
        'hotkey-overlay {' \
        '    skip-at-startup' \
        '}' \
        > /home/testuser/.config/niri/config.kdl && \
    chown -R testuser:testuser /home/testuser/.config

USER testuser
WORKDIR /home/testuser

CMD ["/bin/bash"]
