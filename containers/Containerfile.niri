# niri 测试环境（最小）
# 无头方案：cage(wlroots headless, 60Hz 帧时钟) 托管 niri 嵌套运行
#（niri 官方不支持 headless 输出，见 niri-wm/niri Discussion #714）
FROM voiceinput-host:latest

USER root

RUN pacman -Syu --noconfirm --needed \
        niri \
        && pacman -Scc --noconfirm

# niri 最小配置：关掉动画便于录屏对比
RUN mkdir -p /home/testuser/.config/niri && \
    printf '%s\n' \
        'input {' \
        '}' \
        'animations {' \
        '    workspace-switch {' \
        '        off' \
        '    }' \
        '    window-open {' \
        '        off' \
        '    }' \
        '}' \
        > /home/testuser/.config/niri/config.kdl && \
    chown -R testuser:testuser /home/testuser/.config

USER testuser
WORKDIR /home/testuser

CMD ["/bin/bash"]
