# GNOME 测试环境（最小：gnome-shell/mutter，不装完整 GNOME 套件）
# 无头方案：优先 gnome-shell 嵌套运行在 cage(wlroots headless) 里；
# 嵌套不可用时回退 mutter --wayland --headless（录屏能力受限，见 start-gnome.sh）
FROM aiinput-host:latest

USER root

RUN pacman -Syu --noconfirm --needed \
        gnome-shell \
        mutter \
        xwayland-satellite chromium python-pillow grim \
        && pacman -Scc --noconfirm

USER testuser
WORKDIR /home/testuser

CMD ["/bin/bash"]
