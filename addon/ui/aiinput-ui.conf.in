[Addon]
# 消息路由（lab/spec/ui-split-contract.md §3）：panel/* 由本 addon 的
# UserInterface::update 直发（fcitx5 的 update 回调物理落在 Category=UI
# 的 aiinput-ui 上）；voice/*、theme 由引擎 addon 经 deliverEnvelope 注入
Name=AI Input UI
Category=UI
Version=@PROJECT_VERSION@
Type=SharedLibrary
Library=aiinputui
Depends=wayland,dbus
# UI 选择规则（fcitx5 userinterfacemanager）：UIPriority 大者胜，并列按名
# 字典序降序（"classicui" > "aiinput-ui"，不设则永远排在 classicui 后）。
# 100 > kimpanel 的 50——拼音候选窗由本 addon 接管（容器 P4b 实证 10 次
# update 到达）。旧单体写的 Priority=Default 是无效键（历史遗留，已删）。
UIPriority=100
Enabled=True
Configurable=False
